# Environment Variables

# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ai_real_estate"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-secret-here-change-in-production"

# JWT
JWT_SECRET="your-jwt-secret-change-in-production"
JWT_EXPIRES_IN="7d"
JWT_REFRESH_EXPIRES_IN="30d"

# AI Providers
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
GOOGLE_AI_API_KEY=""

# Maps
GOOGLE_MAPS_API_KEY=""
MAPBOX_ACCESS_TOKEN=""

# Email
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="noreply@airealestate.com"

# Storage
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="us-east-1"
S3_BUCKET_NAME=""

# Redis
REDIS_URL="redis://localhost:6379"

# Payments
STRIPE_SECRET_KEY=""
STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Sentry
SENTRY_DSN=""

# Analytics
GOOGLE_ANALYTICS_ID=""
MIXPANEL_TOKEN=""

# Feature Flags
ENABLE_AI_VALUATIONS=true
ENABLE_VIRTUAL_TOURS=true
ENABLE_MORTGAGE_CALCULATOR=true
ENABLE_MARKET_ANALYSIS=true

# Rate Limiting
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW_MS=60000
